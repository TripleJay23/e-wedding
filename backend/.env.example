# Copy to backend/.env for local use only. Never commit the copied file.
APP_ENV=development
APP_NAME=wedding-ecard-backend
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://wedding_app:CHANGE_ME@127.0.0.1:5432/wedding_ecard_dev
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ISSUER=wedding-ecard-backend
JWT_AUDIENCE=wedding-ecard-mobile
ACCESS_TOKEN_TTL_MINUTES=30
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_ADMIN_PASSWORD
PRIVATE_STORAGE_ROOT=./storage/private
TEMPLATE_STORAGE_ROOT=./storage/private/templates
EVENT_PHOTO_STORAGE_ROOT=./storage/private/event-photos
GENERATED_CARD_STORAGE_ROOT=./storage/private/generated-cards
REPORT_STORAGE_ROOT=./storage/private/reports
IMPORT_EVIDENCE_STORAGE_ROOT=./storage/private/import-evidence
MAX_IMPORT_WORKBOOK_BYTES=10485760
MAX_IMPORT_CANDIDATE_ROWS=5000
