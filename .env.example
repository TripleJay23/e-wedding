# Copy to .env locally. Never commit real values.
# Replace every CHANGE_ME value before starting PostgreSQL or the backend.
APP_ENV=development
APP_NAME=wedding-ecard-backend
API_V1_PREFIX=/api/v1

# Local PostgreSQL container
POSTGRES_DEV_PORT=5432
POSTGRES_DEV_PASSWORD=CHANGE_ME_TO_A_LONG_LOCAL_DATABASE_PASSWORD

# Application database target. Keep the password synchronized with
# POSTGRES_DEV_PASSWORD. No test command may reuse this development database.
DATABASE_URL=postgresql+psycopg://wedding_app:CHANGE_ME@127.0.0.1:5432/wedding_ecard_dev

# Authentication
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ISSUER=wedding-ecard-backend
JWT_AUDIENCE=wedding-ecard-mobile
ACCESS_TOKEN_TTL_MINUTES=30

# One-time local administrator provisioning. Remove the password from the local
# environment after `wedding-bootstrap-admin` succeeds; reruns never overwrite.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_ADMIN_PASSWORD

# Private storage
PRIVATE_STORAGE_ROOT=./backend/storage/private
TEMPLATE_STORAGE_ROOT=./backend/storage/private/templates
EVENT_PHOTO_STORAGE_ROOT=./backend/storage/private/event-photos
GENERATED_CARD_STORAGE_ROOT=./backend/storage/private/generated-cards
REPORT_STORAGE_ROOT=./backend/storage/private/reports
IMPORT_EVIDENCE_STORAGE_ROOT=./backend/storage/private/import-evidence
QR_IMAGE_STORAGE_ROOT=./backend/storage/private/qr-codes

# Upload limits
MAX_EXCEL_UPLOAD_BYTES=10485760
MAX_EVENT_PHOTO_UPLOAD_BYTES=15728640
MAX_REPORT_EXPORT_ROWS=5000
